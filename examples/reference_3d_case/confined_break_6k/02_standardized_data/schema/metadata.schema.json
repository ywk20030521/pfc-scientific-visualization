{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pfc-headless/metadata.schema.json",
  "title": "PFC Headless Data Package Metadata",
  "type": "object",
  "required": ["schema_version", "run_id", "case_id", "engine_dimension", "engine_version", "model_identity", "script_identity", "parameters", "sampling_configuration", "units", "coordinate_system", "time_range", "step_range", "data_files", "file_hashes", "record_counts", "validation_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "integer", "minimum": 0},
    "engine_dimension": {"enum": [2, 3]},
    "engine_version": {"type": ["string", "null"]},
    "model_identity": {"type": "object"},
    "script_identity": {"type": "object"},
    "parameters": {"type": "object"},
    "sampling_configuration": {"type": "object"},
    "units": {"type": "object"},
    "coordinate_system": {"type": "object"},
    "time_range": {"type": "array", "minItems": 2, "maxItems": 2},
    "step_range": {"type": "array", "minItems": 2, "maxItems": 2},
    "data_files": {"type": "array"},
    "file_hashes": {"type": "object"},
    "record_counts": {"type": "object"},
    "validation_status": {"enum": ["PASS", "FAIL", "NOT_VERIFIED"]}
  },
  "additionalProperties": true
}
