{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pfc-headless/run.schema.json",
  "title": "PFC Headless Run",
  "type": "object",
  "required": ["schema_version", "run_id", "case_id", "instance_id", "input_snapshot", "script_version", "start_time", "end_time", "task_status", "mcp_task_id", "output_path", "error"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "case_id": {"type": "integer", "minimum": 0},
    "instance_id": {"type": ["string", "null"]},
    "input_snapshot": {"type": "string", "minLength": 1},
    "script_version": {"type": "string", "minLength": 1},
    "start_time": {"type": "string", "minLength": 1},
    "end_time": {"type": ["string", "null"]},
    "task_status": {"enum": ["PREPARED", "SUBMITTED", "RUNNING", "TIMEOUT_UNKNOWN", "INTERRUPT_REQUESTED", "INTERRUPTED", "COMPLETED", "FAILED", "INVALID"]},
    "mcp_task_id": {"type": ["string", "null"]},
    "execution_nonce": {"type": ["string", "null"]},
    "task_description": {"type": ["string", "null"]},
    "entry_script": {"type": ["string", "null"]},
    "mcp_connection_id": {"type": ["string", "null"]},
    "instance_identity_fingerprint": {"type": ["string", "null"]},
    "instance_snapshot": {"type": ["object", "null"]},
    "execution_options": {"type": "object"},
    "collection_plan": {"type": ["object", "null"]},
    "mcp_evidence": {"type": ["object", "null"]},
    "prepared_utc": {"type": ["string", "null"]},
    "finalization": {"type": ["object", "null"]},
    "feedback_id": {"type": ["string", "null"]},
    "output_path": {"type": "string", "minLength": 1},
    "error": {"type": ["object", "null"]}
  },
  "additionalProperties": true
}
