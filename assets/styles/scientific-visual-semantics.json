{
  "version": "3.0.0",
  "default_theme": "light",
  "themes": {
    "light": {
      "scene_background": "#f7f9fb",
      "panel_background": "#fbfcfd",
      "panel_header_background": "rgba(251, 252, 253, 0.96)",
      "stage_head_background": "rgba(247, 249, 251, 0.88)",
      "legend_background": "rgba(247, 249, 251, 0.9)",
      "chart_background": "#ffffff",
      "chart_header_background": "#ffffff",
      "tooltip_background": "rgba(255, 255, 255, 0.96)",
      "tooltip_border": "#d9d9d5",
      "ink": "#171717",
      "muted": "#6f7074",
      "line": "#cfd6df",
      "line_soft": "#e5e9ee",
      "grid": "#e6e7e4",
      "axis": "#3d3d3d",
      "axis_tick": "#8a8a86",
      "primary": "#3C5488",
      "wall_surface": "#2F6FD0",
      "wall_edge": "#2F6FD0",
      "fracture": "#E64B35",
      "slate": "#8491B4",
      "tan": "#B09C85",
      "accent": "#F39B7F",
      "particle_low": "#24486E",
      "particle_high": "#F2E06B",
      "particle_ramp": [
        {
          "at": 0.0,
          "color": "#24486E"
        },
        {
          "at": 0.2,
          "color": "#366F9E"
        },
        {
          "at": 0.4,
          "color": "#4A9BB0"
        },
        {
          "at": 0.6,
          "color": "#7FBFA0"
        },
        {
          "at": 0.8,
          "color": "#C4D97E"
        },
        {
          "at": 1.0,
          "color": "#F2E06B"
        }
      ],
      "heatmap_low": "#eef1f5",
      "heatmap_mid": "#aab6ca",
      "missing": "#A8ADB7",
      "export_background": "#ffffff"
    }
  },
  "threejs": {
    "background_token": "scene_background",
    "color_space": "sRGB",
    "tone_mapping": "None",
    "particle_material": "MeshStandardMaterial",
    "roughness": 0.62,
    "metalness": 0.015,
    "particle_geometry_2d": "CircleGeometry",
    "particle_geometry_3d": "SphereGeometry",
    "sphere_segments_3d": [
      18,
      12
    ],
    "shadow_map": "PCFSoftShadowMap",
    "lighting": {
      "hemisphere_intensity": 0.72,
      "key_intensity": 1.05,
      "fill_intensity": 0.26
    },
    "projection": {
      "PFC2D": "orthographic",
      "PFC3D": "perspective"
    },
    "views": [
      "fit",
      "isometric",
      "front",
      "top",
      "side"
    ]
  },
  "echarts": {
    "background_token": "chart_background",
    "axis_token": "axis",
    "axis_width_px": 0.8,
    "grid_lines": false,
    "font_family": "Arial, Helvetica, PingFang SC, Microsoft YaHei, sans-serif",
    "tooltip_precision_digits": 8,
    "panel_label_format": "(a)",
    "viewer_layout": "single_column_charts",
    "composite_layout": "content_aware_odd_even"
  },
  "colors": {
    "primary": "#3C5488",
    "fracture": "#E64B35",
    "slate": "#8491B4",
    "tan": "#B09C85",
    "accent": "#F39B7F",
    "particle_low": "#B8CCE4",
    "particle_high": "#3C5488",
    "missing": "#A8ADB7"
  },
  "variables": {
    "ball.position_m": {
      "entity": "ball",
      "color_token": "slate",
      "scale": "continuous"
    },
    "ball.displacement_m": {
      "entity": "ball",
      "color_token": "primary",
      "scale": "continuous"
    },
    "ball.speed_m_s": {
      "entity": "ball",
      "color_token": "slate",
      "scale": "continuous"
    },
    "contact.force_n": {
      "entity": "contact",
      "color_token": "tan",
      "scale": "continuous"
    },
    "fracture.tension": {
      "entity": "fracture",
      "color_token": "primary",
      "scale": "categorical"
    },
    "fracture.shear": {
      "entity": "fracture",
      "color_token": "fracture",
      "scale": "categorical"
    },
    "sample.axial_stress_pa": {
      "entity": "sample",
      "color_token": "primary",
      "scale": "continuous"
    },
    "sample.axial_strain": {
      "entity": "sample",
      "color_token": "slate",
      "scale": "continuous"
    }
  },
  "truth_rules": {
    "missing_color": "missing",
    "interpolate_frames": false,
    "zero_fill": false,
    "uninterpreted_history_is_physical_quantity": false
  }
}
